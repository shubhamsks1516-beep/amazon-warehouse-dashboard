{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "static/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|static).*)",
      "destination": "/index.html"
    }
  ]
}
